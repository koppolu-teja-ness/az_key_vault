# Copy to .env and fill in. Never commit the real .env file.

# Agent 0: export this Azure resource group as the migration source instead
# of passing a .bicep file on the command line.
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=

# AWS Bedrock + CloudFormation
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
MAX_FIX_ATTEMPTS=2
